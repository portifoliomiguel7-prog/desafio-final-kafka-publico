{
  "name": "desafio-cdc",
  "connector.class": "PostgresCdcSourceV2",
  "kafka.auth.mode": "SERVICE_ACCOUNT",
  "kafka.service.account.id": "${KAFKA_PRODUCER_SERVICE_ACCOUNT_ID}",
  "authentication.method": "Password",
  "database.hostname": "${POSTGRES_HOST}",
  "database.port": "5432",
  "database.user": "cdc_user",
  "database.password": "${CDC_PASSWORD}",
  "database.dbname": "neondb",
  "database.sslmode": "require",
  "topic.prefix": "desafio",
  "table.include.list": "payments.accounts,payments.cards,payments.transactions",
  "publication.name": "bootcamp_cdc_pub",
  "publication.autocreate.mode": "disabled",
  "slot.name": "desafio_cdc_slot",
  "slot.drop.on.stop": "false",
  "snapshot.mode": "when_needed",
  "heartbeat.interval.ms": "60000",
  "topic.heartbeat.prefix": "desafio.heartbeat",
  "output.data.format": "AVRO",
  "output.key.format": "AVRO",
  "after.state.only": "false",
  "tombstones.on.delete": "true",
  "decimal.handling.mode": "precise",
  "time.precision.mode": "adaptive",
  "key.converter.key.subject.name.strategy": "TopicNameStrategy",
  "value.converter.value.subject.name.strategy": "TopicNameStrategy",
  "value.converter.auto.register.schemas": "true",
  "value.converter.connect.meta.data": "true",
  "topic.creation.topic_prefix_match.partitions": "1",
  "topic.creation.topic_prefix_match.cleanup.policy": "delete",
  "topic.creation.topic_prefix_match.retention.ms": "604800000",
  "topic.creation.topic_prefix_match.retention.bytes": "-1",
  "provide.transaction.metadata": "false",
  "tasks.max": "1"
}
